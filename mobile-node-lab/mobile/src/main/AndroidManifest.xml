<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<application android:name=".QuestBackApplication" android:allowBackup="false" android:label="TGC Staff Companion" android:icon="@drawable/tgc_logo" android:roundIcon="@drawable/tgc_logo"
 android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
 <provider android:name="rikka.shizuku.ShizukuProvider"
  android:authorities="${applicationId}.shizuku"
  android:exported="true"
  android:multiprocess="false"
  android:enabled="true"
  android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>
 <service android:name=".VRChatPipelineService" android:enabled="true"
   android:exported="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
     android:value="User-enabled VRChat personal notification WebSocket with visible ongoing indicator" />
 </service>
 <service android:name=".MobileNodeService" android:enabled="true" android:exported="false"
   android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
     android:value="User-initiated continuous VRChat player event monitoring with a persistent notification" />
 </service>
 <service android:name=".QuestOscService" android:enabled="true" android:exported="false"
   android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
     android:value="User-initiated Quest-native VRChat OSC Live Chatbox and microphone PTT with visible notification" />
 </service>
 <service android:name=".FloatingCompanionService" android:enabled="true" android:exported="false"
   android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
     android:value="Optional user-controlled floating quick-tools overlay for VRChat Mobile" />
 </service>
 <provider android:name="androidx.core.content.FileProvider"
   android:authorities="${applicationId}.updates"
   android:exported="false"
   android:grantUriPermissions="true">
  <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/tgc_update_paths"/>
 </provider>
 <activity android:name=".QuestToolsActivity" android:exported="false"/>
 <activity android:name=".ThemeEditorActivity" android:exported="false"/>
 <activity android:name=".StaffDirectoryActivity" android:exported="false"/>
 <activity android:name=".CompanionSetupActivity" android:exported="false"/>
 <activity android:name=".WhatsNewActivity" android:exported="false"/>
 <activity android:name=".ExtendedAvatarActivity" android:exported="false"/>
 <activity android:name=".PlayerActivityLogActivity" android:exported="false"/>
 <activity android:name=".FriendHubActivity" android:exported="false"/>
 <activity android:name=".PresenceActivity" android:exported="false"/>
 <activity android:name=".VRChatNotesActivity" android:exported="false"/>
 <activity android:name=".VRChatInboxActivity" android:exported="false"/>
 <activity android:name=".VRChatInstanceActivity" android:exported="false"/>
 <activity android:name=".VRChatGroupToolsActivity" android:exported="false"/>
 <activity android:name=".VRChatUserGroupsActivity" android:exported="false"/>
 <activity android:name=".VRChatPeoplePickerActivity" android:exported="false"/>
 <activity android:name=".VRChatAvatarActivity" android:exported="false"/>
 <activity android:name=".InviteCodeActivity" android:exported="false"/>
 <activity android:name=".VRChatAccountActivity" android:exported="false"/>
 <activity android:name=".VRChatBrowseActivity" android:exported="false"/>
 <activity android:name=".VRChatDetailActivity" android:exported="false"/>
 <activity android:name=".MobileUpdaterActivity" android:exported="false"/>
 <activity android:name=".MobileDeployActivity" android:exported="false"/>
 <activity android:name=".CompanionLicenseActivity" android:exported="false"/>
 <activity android:name=".CompanionActivity" android:exported="true">
  <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
 </activity>
 <activity android:name=".MainActivity" android:exported="true">
  <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/>
   <data android:mimeType="text/plain"/><data android:mimeType="application/octet-stream"/></intent-filter>
 </activity>
</application>
</manifest>